{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (with dartcounter)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run_api.py",
      "args": ["--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    },
    {
      "name": "Backend (API only, no dartcounter)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run_api.py",
      "args": ["--host", "127.0.0.1", "--port", "8000", "--api-only"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false
    }
  ]
}
