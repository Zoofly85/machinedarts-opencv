    "version:set": "node scripts/set-version.mjs",
    "tauri:build:home": "node scripts/build-tauri-with-updater-pubkey.mjs home",
    "tauri:build:opencv": "node scripts/build-tauri-with-updater-pubkey.mjs opencv",
    "tauri:build:club-board": "node scripts/build-tauri-with-updater-pubkey.mjs club-board",
    "tauri:build:club-master": "node scripts/build-tauri-with-updater-pubkey.mjs club-master"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "framer-motion": "^12.34.2",
    "lucide-react": "^0.575.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^22.19.11",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
