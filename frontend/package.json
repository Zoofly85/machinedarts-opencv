{
  "name": "machine-darts-frontend",
  "version": "1.1.24",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:owner-analytics": "node scripts/dev-owner-analytics.mjs",
    "dev:home": "vite --mode home",
    "dev:opencv": "vite --mode opencv",
    "dev:club-board": "vite --mode club-board",
    "dev:club-master": "vite --mode club-master",
    "build": "tsc -b && vite build",
    "build:home": "tsc -b && vite build --mode home",
    "build:opencv": "tsc -b && vite build --mode opencv",
    "build:club-board": "tsc -b && vite build --mode club-board",
    "build:club-master": "tsc -b && vite build --mode club-master",
    "preview": "vite preview",
    "test:online-flow": "node scripts/online-peer-flow-smoke.mjs",
    "test:online-apply": "python ../backend/tools/online_x01_apply_smoke.py",
