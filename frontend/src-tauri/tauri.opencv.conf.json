{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Machine Darts OpenCV",
  "version": "1.1.24",
  "identifier": "com.machine.darts.opencv",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:opencv",
    "beforeBuildCommand": "npm run build:opencv"
  },
  "app": {
    "windows": [
      {
        "title": "Machine Darts OpenCV",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "../../backend/dist/darts-backend",
      "../../frontend/dist",
      "../../build/secure-models/models",
      "../../voice_packs"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Zoofly85/machine-darts-updater/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBKEY"
    }
  }
}
